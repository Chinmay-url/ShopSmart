# ============================================
# ShopSmart - Environment Variable Template
# ============================================
# Copy this file to `.env` in the repository root and fill in your own values.
#
#   cp .env.example .env       # macOS / Linux
#   copy .env.example .env     # Windows
#
# The real `.env` file is git-ignored and must NEVER be committed.
# ============================================


# --------------------------------------------
# SerpApi  (REQUIRED - core data source)
# --------------------------------------------
# ShopSmart queries SerpApi's `google_shopping` engine to retrieve live
# Google Shopping results, product reviews, and merchant data.
# Get a free key at https://serpapi.com/  (~100 free searches/month)
#
# NOTE: the variable name is SERP_API_KEY (not SERPAPI_KEY).
SERP_API_KEY=your_serpapi_api_key_here


# --------------------------------------------
# MongoDB  (REQUIRED)
# --------------------------------------------
# Local install:  mongodb://localhost:27017/shopsmart
# Atlas:          mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopsmart
MONGODB_URI=mongodb://localhost:27017/shopsmart


# --------------------------------------------
# JWT  (REQUIRED)
# --------------------------------------------
# Used to sign and verify auth tokens. Use a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_change_in_production


# --------------------------------------------
# Server
# --------------------------------------------
PORT=5000
NODE_ENV=development


# --------------------------------------------
# Groq API  (OPTIONAL - powers the "Rupees" chatbot)
# --------------------------------------------
# Without this key the chatbot route returns HTTP 503 and the rest of the
# app works normally. Get a key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here


# --------------------------------------------
# Email  (OPTIONAL - powers price-drop alerts)
# --------------------------------------------
# Uses Nodemailer over Gmail. This MUST be a Google App Password, not your
# normal account password.
# Create one at: Google Account -> Security -> 2-Step Verification -> App Passwords
# Without these the scheduler skips sending and logs a warning instead.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_google_app_password
